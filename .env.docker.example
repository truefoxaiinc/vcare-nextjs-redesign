# Vcare production deployment only. Keep this file private (chmod 600 .env).
# Host port is bound to 127.0.0.1; Apache can proxy to localhost:18660.
APP_PORT=18660

POSTGRES_USER=vcare
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=vcare
# URL-encode special characters in the password when placing it in DATABASE_URL.
DATABASE_URL=postgresql://vcare:REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD@db:5432/vcare?schema=public

NEXT_PUBLIC_SITE_URL=https://www.vcarehardwoodfloors.ca
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

ADMIN_USERNAME=
ADMIN_PASSWORD=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_TO_EMAIL=sales@vcarehardwoodfloors.ca
NOTIFICATION_WORKER_SECRET=

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
